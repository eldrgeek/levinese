---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Ask"
  description="Ask Bill — converse with Levin's work. Coming soon."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-16 pb-20">
    <div class="max-w-xl">
      <p class="text-sm font-medium text-teal uppercase tracking-widest mb-3">Ask</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-medium text-ink mb-4">Ask Bill</h1>
      <p class="text-muted leading-relaxed mb-6 font-serif italic text-lg">
        Coming soon.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Ask Bill will let you converse directly with Levin's body of work — papers, transcripts, essays, and more — answered in his voice, with citations.
      </p>
      <p class="text-muted leading-relaxed">
        The gate for shipping it is a RAG-able database of the full corpus paired with an AI assistant that can synthesize and cite from it. It's on the way.
      </p>
    </div>
  </div>
</Base>
