---
import Base from '../../layouts/Base.astro';

const API_URL = import.meta.env.PUBLIC_LEVIN_ASK_API_URL ?? '';
const API_TOKEN = import.meta.env.PUBLIC_LEVIN_ASK_TOKEN ?? '';

const starters = [
  "What is the cognitive light cone, and why does it replace asking 'is this thing conscious?'",
  "How does bioelectricity act as an information processing layer in development?",
  "What is target morphology, and how do cells remember the correct body plan?",
  "How does Levin frame cancer as a failure of collective intelligence?",
  "What is the TAME framework and how does it extend agency beyond brains?",
];
---

<Base
  title="Ask"
  description="Ask questions against Michael Levin's full corpus — 68 papers, 293 transcripts, 350 blog posts. Answered in his voice with citations."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-12 pb-20">

    <!-- Header -->
    <div class="mb-8">
      <p class="text-sm font-medium text-teal uppercase tracking-widest mb-3">Ask</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-medium text-ink mb-3">The Corpus Speaks</h1>
      <p class="text-muted max-w-xl leading-relaxed">
        Questions answered from 68 papers, 293 transcripts, and 350 essays — grounded in what Levin actually wrote, with citations.
      </p>
    </div>

    <!-- Ask form -->
    <div id="ask-form">
      <div class="mb-5">
        <p class="text-xs font-medium text-muted uppercase tracking-wider mb-3">Try asking</p>
        <div class="flex flex-wrap gap-2">
          {starters.map(s => (
            <button
              class="starter-btn text-sm text-teal bg-teal-light border border-teal/20 rounded-lg px-3 py-1.5 hover:bg-teal/10 transition-colors text-left leading-snug"
              data-q={s}
            >
              {s}
            </button>
          ))}
        </div>
      </div>

      <div>
        <textarea
          id="question-input"
          rows="3"
          placeholder="Ask anything about Levin's work… (Cmd+Enter to submit)"
          class="w-full bg-white border border-border rounded-xl px-4 py-3 text-ink placeholder-muted/60 focus:outline-none focus:border-teal/50 focus:ring-2 focus:ring-teal/10 resize-none text-sm leading-relaxed"
        ></textarea>
        <div class="mt-3 flex items-center justify-between">
          <p id="form-error" class="text-sm text-amber hidden"></p>
          <div class="ml-auto">
            <button
              id="submit-btn"
              class="inline-flex items-center gap-2 bg-teal text-white text-sm font-medium px-5 py-2.5 rounded-lg hover:bg-teal-mid transition-colors"
            >
              <span>Ask the corpus</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Loading -->
    <div id="ask-loading" class="hidden py-16 text-center">
      <div class="inline-flex flex-col items-center gap-4">
        <div class="w-8 h-8 border-2 border-teal/30 border-t-teal rounded-full animate-spin"></div>
        <p class="text-muted text-sm">Searching corpus and synthesizing…</p>
      </div>
    </div>

    <!-- Result -->
    <div id="ask-result" class="hidden">

      <div class="mb-5 bg-surface border border-border rounded-xl px-5 py-4">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 shrink-0 w-6 h-6 rounded-full bg-teal text-white text-xs font-mono flex items-center justify-center font-medium">Q</span>
          <p id="result-question" class="font-medium text-ink leading-snug"></p>
        </div>
      </div>

      <div class="mb-6 bg-white border border-border rounded-xl px-5 py-5">
        <div class="flex items-start gap-3">
          <span class="mt-0.5 shrink-0 w-6 h-6 rounded-full bg-parchment border border-border text-teal text-xs font-mono flex items-center justify-center font-medium">A</span>
          <div id="result-answer" class="font-serif text-ink leading-relaxed min-w-0 flex-1"></div>
        </div>
      </div>

      <div class="mb-8">
        <h2 class="text-xs font-medium text-muted uppercase tracking-wider mb-3">Sources</h2>
        <div id="citations-list" class="space-y-2"></div>
      </div>

      <button
        id="reset-btn"
        class="inline-flex items-center gap-2 text-teal text-sm font-medium border border-teal/30 rounded-lg px-4 py-2 hover:bg-teal-light transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
        </svg>
        Ask another question
      </button>

    </div>
  </div>
</Base>

<script define:vars={{ API_URL, API_TOKEN }}>
  const askForm    = document.getElementById('ask-form');
  const askLoading = document.getElementById('ask-loading');
  const askResult  = document.getElementById('ask-result');
  const input      = document.getElementById('question-input');
  const submitBtn  = document.getElementById('submit-btn');
  const formError  = document.getElementById('form-error');
  const resultQ    = document.getElementById('result-question');
  const resultA    = document.getElementById('result-answer');
  const citeList   = document.getElementById('citations-list');
  const resetBtn   = document.getElementById('reset-btn');

  document.querySelectorAll('.starter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      input.value = btn.dataset.q;
      input.focus();
    });
  });

  submitBtn.addEventListener('click', submit);
  input.addEventListener('keydown', e => {
    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) submit();
  });
  resetBtn.addEventListener('click', reset);

  function reset() {
    askResult.classList.add('hidden');
    askForm.classList.remove('hidden');
    input.value = '';
    input.focus();
  }

  async function submit() {
    const q = input.value.trim();
    if (!q) {
      showError('Please enter a question.');
      return;
    }
    if (!API_URL) {
      showError('API not configured — check PUBLIC_LEVIN_ASK_API_URL.');
      return;
    }
    formError.classList.add('hidden');
    askForm.classList.add('hidden');
    askLoading.classList.remove('hidden');
    askResult.classList.add('hidden');

    try {
      const res = await fetch(`${API_URL}/ask`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${API_TOKEN}`,
        },
        body: JSON.stringify({ question: q, top_k: 8 }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      resultQ.textContent = q;
      resultA.innerHTML = renderMd(data.answer || '');
      citeList.innerHTML = (data.citations || []).map(citationCard).join('');

      askLoading.classList.add('hidden');
      askResult.classList.remove('hidden');
    } catch (err) {
      askLoading.classList.add('hidden');
      askForm.classList.remove('hidden');
      showError(`Error: ${err.message}`);
    }
  }

  function showError(msg) {
    formError.textContent = msg;
    formError.classList.remove('hidden');
  }

  const TYPE_COLORS = {
    paper:    'bg-blue-50 text-blue-700 border-blue-200',
    video:    'bg-purple-50 text-purple-700 border-purple-200',
    blog:     'bg-green-50 text-green-700 border-green-200',
    magazine: 'bg-orange-50 text-orange-700 border-orange-200',
    substack: 'bg-amber-50 text-amber-700 border-amber-200',
    x:        'bg-gray-50 text-gray-700 border-gray-200',
  };

  function citationCard(c) {
    const badge = TYPE_COLORS[c.type] || 'bg-surface text-muted border-border';
    return `<div class="border border-border rounded-lg px-4 py-3 bg-white text-sm">
      <div class="flex items-start gap-3">
        <span class="shrink-0 mt-0.5 text-xs font-medium px-1.5 py-0.5 rounded border ${badge}">${h(c.type)}</span>
        <div class="min-w-0">
          <p class="font-medium text-ink leading-snug">${h(c.title)} <span class="text-muted font-normal">(${c.year})</span></p>
          <p class="text-muted mt-1 text-xs leading-relaxed">${h(c.snippet)}</p>
        </div>
      </div>
    </div>`;
  }

  function h(s) {
    return String(s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderMd(md) {
    return md.split(/\n\n+/).map(para => {
      let p = para.trim();
      p = p.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      p = p.replace(/\*(.+?)\*/g, '<em>$1</em>');
      p = p.replace(/`(.+?)`/g, '<code class="bg-surface px-1 rounded text-xs font-mono">$1</code>');
      p = p.replace(/\[SOURCE:\s*([^\]]+)\]/g,
        '<span class="text-xs text-muted not-italic">↑ $1</span>');
      return `<p class="mb-4 last:mb-0">${p.replace(/\n/g,'<br>')}</p>`;
    }).join('');
  }
</script>
