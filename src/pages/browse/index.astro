---
import Base from '../../layouts/Base.astro';
import { browseItems } from '../../data/colophon';

const types = ['paper', 'video', 'blog', 'substack'] as const;
const years = [...new Set(browseItems.map(i => i.year))].sort((a, b) => b - a);

const typeLabels: Record<string, string> = {
  paper: 'Paper',
  video: 'Video',
  blog: 'Blog post',
  substack: 'Substack',
};
---
<Base title="Browse" description="Browse the Michael Levin corpus — 364 papers, 333 transcripts, blogs, Substack, and X archive. Filter by type, year, and topic.">

  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-12">
    <div class="mb-8">
      <p class="text-sm font-medium text-teal uppercase tracking-widest mb-3">Browse</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-medium text-ink mb-4">The Corpus</h1>
      <p class="text-muted max-w-2xl leading-relaxed mb-6">
        364 papers, 333 video transcripts, 350 blog posts, 22 magazine articles, 7 Substack posts, 4 X archive pages — plus an adjacent-corpus bibliography. A curated selection is shown below, filterable by type and year. Full corpus search is coming in v1 via LanceDB.
      </p>
      <div class="bg-amber-light border border-amber/20 rounded-lg px-4 py-3 text-sm text-amber inline-block">
        v0 note: This page shows a curated representative selection. Full LanceDB search launches in v1.
      </div>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap gap-2 mb-8 pb-6 border-b border-border" id="filters">
      <button
        data-filter="all"
        class="filter-btn px-4 py-2 rounded-md text-sm font-medium border border-teal bg-teal text-white transition-all"
      >
        All ({browseItems.length})
      </button>
      {types.map(type => (
        <button
          data-filter={type}
          class="filter-btn px-4 py-2 rounded-md text-sm font-medium border border-border text-muted hover:border-teal/40 hover:text-ink transition-all"
        >
          {typeLabels[type]}s ({browseItems.filter(i => i.type === type).length})
        </button>
      ))}
    </div>

    <!-- Results -->
    <div class="space-y-3 mb-12" id="results">
      {browseItems.map(item => (
        <div
          class="browse-item bg-white border border-border rounded-lg p-4 hover:border-teal/30 transition-all"
          data-type={item.type}
          data-year={item.year}
        >
          <div class="flex items-start gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class={`text-xs font-medium px-2 py-0.5 rounded-full border shrink-0
                  ${item.type === 'paper' ? 'bg-teal-light text-teal border-teal/20' : ''}
                  ${item.type === 'video' ? 'bg-amber-light text-amber border-amber/20' : ''}
                  ${item.type === 'blog' ? 'bg-surface text-muted border-border' : ''}
                  ${item.type === 'substack' ? 'bg-surface text-muted border-border' : ''}
                `}>
                  {typeLabels[item.type]}
                </span>
                <span class="text-xs text-muted font-mono">{item.year}</span>
              </div>
              <h3 class="font-medium text-ink text-sm mb-1 leading-snug">{item.title}</h3>
              <p class="text-xs text-muted">{item.venue}</p>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {item.topics.map(t => (
                  <span class="text-xs bg-surface text-muted px-2 py-0.5 rounded-full border border-border">{t}</span>
                ))}
              </div>
            </div>
            {'doi' in item && item.doi && (
              <a
                href={`https://doi.org/${item.doi}`}
                class="shrink-0 text-xs text-teal hover:text-teal-mid font-medium"
                target="_blank"
                rel="noopener noreferrer"
              >
                DOI →
              </a>
            )}
            {'url' in item && item.url && (
              <a
                href={item.url}
                class="shrink-0 text-xs text-teal hover:text-teal-mid font-medium"
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

</Base>

<script>
  const buttons = document.querySelectorAll('.filter-btn') as NodeListOf<HTMLButtonElement>;
  const items = document.querySelectorAll('.browse-item') as NodeListOf<HTMLElement>;

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      // Update button states
      buttons.forEach(b => {
        b.classList.remove('bg-teal', 'text-white', 'border-teal');
        b.classList.add('border-border', 'text-muted');
      });
      btn.classList.add('bg-teal', 'text-white', 'border-teal');
      btn.classList.remove('border-border', 'text-muted');

      // Filter items
      items.forEach(item => {
        if (filter === 'all' || item.dataset.type === filter) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>
